# Application
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
# Список origins через запятую или JSON-массив:
# ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database
POSTGRES_USER=jobautoapply
POSTGRES_PASSWORD=jobautoapply
POSTGRES_DB=jobautoapply
DATABASE_URL=postgresql+asyncpg://jobautoapply:jobautoapply@db:5432/jobautoapply

# Redis
REDIS_URL=redis://redis:6379/0

# hh.ru OAuth
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
HH_REDIRECT_URI=http://localhost:3000/auth/hh/callback
HH_API_BASE_URL=https://api.hh.ru

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI (optional)
OPENAI_API_KEY=

# SMTP (для OTP при регистрации)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
SMTP_TLS=true
