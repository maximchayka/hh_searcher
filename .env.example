# Application
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
# Локальная разработка:
# ALLOWED_ORIGINS=["http://localhost:3000"]
# Продакшн (после настройки nginx + Let's Encrypt):
ALLOWED_ORIGINS=["https://jobsearch.infoteq.ru"]

# Database
POSTGRES_USER=jobautoapply
POSTGRES_PASSWORD=jobautoapply
POSTGRES_DB=jobautoapply
DATABASE_URL=postgresql+asyncpg://jobautoapply:jobautoapply@db:5432/jobautoapply

# Redis
REDIS_URL=redis://redis:6379/0

# hh.ru OAuth
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
HH_REDIRECT_URI=https://jobsearch.infoteq.ru/auth/hh/callback
HH_API_BASE_URL=https://api.hh.ru

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI (optional)
OPENAI_API_KEY=

# SMTP (для OTP при регистрации)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
SMTP_TLS=true

# SSL / Let's Encrypt (используется в init-letsencrypt.sh)
CERTBOT_EMAIL=your@infoteq.ru
# CERTBOT_STAGING=1   # раскомментируйте для тест-режима (не выдаёт реальный сертификат)
